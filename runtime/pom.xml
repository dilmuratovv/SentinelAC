<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>uz.sentinel.ac</groupId>
    <artifactId>sentinel-parent</artifactId>
    <version>2.6.0</version>
  </parent>
  <artifactId>sentinel-runtime</artifactId>
  <!-- Only third-party libraries/assets from the hash-pinned upstream distribution. No engine/API bytecode is reused. -->
  <dependencies>
    <dependency>
      <groupId>maven.modrinth</groupId>
      <artifactId>grimac</artifactId>
      <version>baDrVvfo</version>
      <optional>true</optional>
    </dependency>
  </dependencies>
  <build>
    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>maven.modrinth:grimac</artifact>
                  <includes>
                    <include>ac/grim/grimac/shaded/**</include>
                    <include>com/lmax/**</include>
                    <include>assets/**</include>
                    <include>META-INF/services/**</include>
                    <include>META-INF/packetevents*</include>
                    <include>META-INF/LICENSE*</include>
                  </includes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>**/module-info.class</exclude>
                    <!-- This upstream compatibility shim is rebuilt from source in plugin/. -->
                    <exclude>ac/grim/grimac/shaded/kyori/adventure/text/serializer/gson/impl/GsonDataComponentValueConverterProvider.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>ac.grim.grimac.shaded</pattern>
                  <shadedPattern>uz.sentinel.engine.libs</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>verify-library-carrier</id>
            <phase>prepare-package</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${project.basedir}/../tools/verify_runtime_input.py</argument>
                <argument>${settings.localRepository}/maven/modrinth/grimac/baDrVvfo/grimac-baDrVvfo.jar</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>finish-lambda-relocation</id><phase>package</phase><goals><goal>exec</goal></goals>
            <configuration><executable>python3</executable><arguments>
              <argument>${project.basedir}/../tools/relocate_runtime.py</argument>
              <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
            </arguments></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
